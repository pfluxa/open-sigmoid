    "lsp": {
        "pyright": {
            "settings": {
                "python": {
                    "pythonPath": "/home/pedro/python-envs/sigmoid/env/bin/python"
                }
            }
        }
    },
    "terminal": {
        "detect_venv": {
            "on": {
